# ---------------------------------------------------------------
# Fichier d'exemple des variables d'environnement.
# Copier ce fichier en ".env" puis l'adapter :
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# Le fichier ".env" est ignoré par Git (jamais commité).
# ---------------------------------------------------------------

# --- Serveur Node.js / Express ---
PORT=5000

# --- MongoDB (base NoSQL de l'application moderne) ---
MONGO_URI=mongodb://localhost:27017/fitness-app

# --- Authentification JWT ---
# À REMPLACER impérativement par une clé longue, aléatoire et secrète.
JWT_SECRET=remplace_par_une_cle_secrete_longue_et_aleatoire
JWT_EXPIRES_IN=24h

# --- Intégration SOAP : client du legacy-medical-api (Spring Boot) ---
# URL du WSDL exposé par Spring-WS sur /ws/mon-service.wsdl
MEDICAL_WSDL_URL=http://localhost:8080/ws/mon-service.wsdl
# Délai maximal d'attente de la réponse SOAP, en millisecondes
MEDICAL_SOAP_TIMEOUT=8000
